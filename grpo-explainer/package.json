{
  "name": "grpo-explainer",
  "version": "1.0.0",
  "description": "A narrated 2048 explainer for GRPO and online reinforcement learning",
  "repository": "https://github.com/syedmujahedalih/2048-post-training",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/captions": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/media": "4.0.538",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --port \"${REMOTION_PORT:?Set REMOTION_PORT in your local environment}\"",
    "audio": "python3 scripts/prepare_assets.py",
    "review": "node scripts/review_stills.mjs",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
